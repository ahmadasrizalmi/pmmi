# Core
DATABASE_URL=postgresql://pmmi:change-me@host.docker.internal:5432/pmmi
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_TOKEN=replace-with-random-bootstrap-token
PUBLIC_APP_URL=https://app.pondokmultimedia.id
PUBLIC_API_URL=https://app.pondokmultimedia.id/api

# MinIO
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=pmmi

# PMMI AI Gateway -> 9Router
NINEROUTER_BASE_URL=http://host.docker.internal:20128
NINEROUTER_API_KEY=
AI_REQUESTS_PER_MINUTE=20

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=PMMI <noreply@pondokmultimedia.id>
RESEND_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret
WHATSAPP_PROVIDER_TOKEN=replace-with-random-provider-token
WHATSAPP_PAIRING_PHONE=628xxxxxxxxxx

# Hermes host jobs worker
HERMES_EXECUTION_MODE=real
HERMES_BINARY=hermes
HERMES_WORKSPACE_BASE=/srv/pmmi/workspaces
HERMES_TEMPLATE_PROFILE=
HERMES_DEFAULT_MODEL=
PMMI_AI_GATEWAY_URL=http://127.0.0.1:3001/v1
WORKER_INTERVAL_MS=2000

# Backup
PMMI_BACKUP_ROOT=/srv/pmmi/backups
PMMI_BACKUP_RETENTION_DAYS=14
