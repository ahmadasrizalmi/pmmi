FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/whatsapp/package.json apps/whatsapp/package.json
COPY packages/db/package.json packages/db/package.json
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_API_URL=https://ai.pondokmultimedia.id
ARG VITE_DASHBOARD_URL=https://app.pondokmultimedia.id
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DASHBOARD_URL=$VITE_DASHBOARD_URL
RUN npm run build:web
FROM nginx:1.27-alpine
COPY infra/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
