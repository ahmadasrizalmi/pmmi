[Unit]
Description=PMMI worker with shared Hermes runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmmi
Group=pmmi
WorkingDirectory=/home/pmmiserver/pmmi/current
EnvironmentFile=/home/pmmiserver/pmmi/.env
Environment=HERMES_ENABLED=true
Environment=HOME=/srv/pmmi/hermes-home
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
# Node 22 dibundel oleh instalasi Hermes (venv uv). Worker dist wajib di-build
# di host sebelum unit ini di-enable: npm ci && npm run build:worker
ExecStart=/srv/pmmi/hermes-home/.hermes/node/bin/node /home/pmmiserver/pmmi/current/apps/worker/dist/index.js
Restart=on-failure
RestartSec=5s

# The Hermes profile/workspace model is application isolation, not an OS sandbox.
# This service limits the worker/Hermes process to PMMI-owned writable paths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true TIDAK dipakai — worker dir berada di bawah /home/pmmiserver
ReadWritePaths=/srv/pmmi/workspaces /srv/pmmi/hermes-home
ReadOnlyPaths=/home/pmmiserver/pmmi/current
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
