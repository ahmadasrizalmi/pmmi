[Unit]
Description=PMMI operations health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pmmi
Group=pmmi
EnvironmentFile=/home/pmmiserver/pmmi/.env
Environment=API_URL=http://127.0.0.1:3001
Environment=DISK_PATH=/
Environment=NINE_ROUTER_URL=http://127.0.0.1:20128
ExecStart=/home/pmmiserver/pmmi/current/infra/scripts/ops-monitor.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# NOTE: ProtectHome=true TIDAK dipakai — script berada di bawah /home/pmmiserver
ReadOnlyPaths=/home/pmmiserver/pmmi/current
